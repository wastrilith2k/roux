# =============================================================================
# Companion Framework — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# REQUIRED vars are marked with [REQUIRED] — the system won't work without them.
# Everything else is optional and enables additional features.

# =============================================================================
# REQUIRED: Database & Infrastructure
# =============================================================================

# PostgreSQL [REQUIRED]
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=companion
POSTGRES_USER=companion
POSTGRES_PASSWORD=change_me

# Redis [REQUIRED] — used for Celery task queue and pub/sub
REDIS_URL=redis://redis:6379/0

# Environment [REQUIRED]
ENVIRONMENT=production  # 'production' or 'development'

# =============================================================================
# OPTIONAL: Authentication Provider
# =============================================================================
# Options: 'firebase' (default) or 'cognito'
AUTH_PROVIDER=firebase

# --- Firebase (if AUTH_PROVIDER=firebase) ---
FIREBASE_PROJECT_ID=

# --- AWS Cognito (if AUTH_PROVIDER=cognito) ---
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_REGION=us-east-1

# =============================================================================
# REQUIRED: LLM Providers (configure at least one)
# =============================================================================
# The system uses a provider chain with automatic failover.
# Order: OpenRouter -> Fireworks -> DeepSeek -> OpenAI -> Anthropic

# OpenRouter (free tier available — easiest to get started)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_TOOL_MODEL=openrouter/hunter-alpha

# Fireworks AI (primary production provider)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p2
FIREWORKS_FALLBACK_MODEL=accounts/fireworks/models/kimi-k2-instruct-0905

# OpenAI (used for embeddings, tool calling, and as fallback)
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Anthropic Claude (last-resort fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek (direct API access)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# OPTIONAL: Companion Identity
# =============================================================================

# Which companion instance to use (matches instances/<name>/)
COMPANION_ID=kai

# Primary user email (for calendar/gmail integration)
COMPANION_PRIMARY_USER_EMAIL=user@example.com

# =============================================================================
# OPTIONAL: Neo4j Knowledge Graph (Graphiti)
# =============================================================================

NEO4J_GRAPHITI_URI=bolt://graphiti-neo4j:7687
NEO4J_GRAPHITI_USER=neo4j
NEO4J_GRAPHITI_PASSWORD=change_me

# Entity extraction and embedding provider ('openai' or 'ollama')
ENTITY_EXTRACTOR=openai
EMBEDDING_PROVIDER=openai

# =============================================================================
# OPTIONAL: Google Integration (Calendar, Gmail, Docs)
# =============================================================================
# Requires Google Cloud OAuth credentials. See README for setup.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Feature flags
COMPANION_GMAIL_CHECK_ENABLED=false
COMPANION_CALENDAR_AWARENESS_ENABLED=true
COMPANION_CALENDAR_SCHEDULE_ENABLED=true

# =============================================================================
# OPTIONAL: Telegram Bot (Proactive Messaging)
# =============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COMPANION_TELEGRAM_ENABLED=true

# Ops bot (system notifications — separate from the companion)
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# =============================================================================
# OPTIONAL: Image Generation
# =============================================================================
# Provider: 'nanobanana' (free, Gemini-based) or 'runcomfy' (paid, ComfyUI)
# Per-companion provider selection in instances/<name>/persona.yaml

IMAGE_PROVIDER=nanobanana

# NanoBanana (free — uses Google AI Studio / Gemini)
NANOBANANA_API_KEY=
# Or use your Google AI Studio key directly:
# GOOGLE_AI_STUDIO_KEY=

# RunComfy (paid — for custom LoRA workflows)
RUNCOMFY_API_KEY=
RUNCOMFY_PERSONAL_DEPLOYMENT_ID=
RUNCOMFY_GENERAL_DEPLOYMENT_ID=

# Image Storage Provider (persistent hosting for generated images)
# Options: 'cloudinary' (default) or 's3'
IMAGE_STORAGE_PROVIDER=cloudinary

# --- Cloudinary (if IMAGE_STORAGE_PROVIDER=cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AWS S3 (if IMAGE_STORAGE_PROVIDER=s3) ---
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=              # Optional: for S3-compatible services (MinIO, DigitalOcean Spaces, etc.)
# AWS_S3_KEY_PREFIX=companion       # Optional: prefix for all keys (default: companion)

# =============================================================================
# OPTIONAL: Voice / TTS
# =============================================================================

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
COMPANION_VOICE_ENABLED=false

# =============================================================================
# OPTIONAL: Web Search
# =============================================================================

TAVILY_API_KEY=

# =============================================================================
# OPTIONAL: Monitoring & Error Tracking
# =============================================================================

SENTRY_DSN=

# =============================================================================
# OPTIONAL: Autonomy & Behavior
# =============================================================================

COMPANION_AUTONOMY_ENABLED=true
COMPANION_REACH_OUT_INTERVAL=15
COMPANION_INNER_MONOLOGUE_ENABLED=true
COMPANION_RESPONSE_CRITIC_ENABLED=true
COMPANION_CODE_EXECUTION_ENABLED=false
CODE_EXECUTOR_URL=http://companion-code-executor:5001

# =============================================================================
# OPTIONAL: Flask / Server
# =============================================================================

SECRET_KEY=change-me-in-production
CORS_ORIGINS=*
LOG_LEVEL=INFO
