# =============================================================================
# Companion Framework — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All ports are configurable to avoid conflicts with other services.

# --- Service Ports ---
BACKEND_PORT=5010
EXECUTOR_PORT=5011
POSTGRES_PORT=5442
REDIS_PORT=6389
NEO4J_HTTP_PORT=7485
NEO4J_BOLT_PORT=7698
HEALTH_CHECK_PORT=8090

# Container name prefix (prevents Docker name collisions)
COMPOSE_PROJECT_NAME=companion

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_DB=companion
POSTGRES_USER=companion
POSTGRES_PASSWORD=change_me

# --- Redis ---
REDIS_URL=redis://redis:${REDIS_PORT:-6389}/0

# --- Neo4j (Knowledge Graph) ---
NEO4J_GRAPHITI_URI=bolt://neo4j:${NEO4J_BOLT_PORT:-7698}
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# --- LLM Providers (configure at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# Ollama (local models)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest

# --- Search ---
TAVILY_API_KEY=

# --- Voice (optional) ---
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID=aura-asteria-en
DEEPGRAM_TTS_MODEL=aura-asteria-en

# --- Google OAuth (optional — for calendar/drive integration) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Telegram Bot (optional — for proactive messaging) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- n8n Automation (optional) ---
N8N_HOST=
N8N_API_KEY=

# --- Image Generation (optional) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Zep Memory (optional) ---
ZEP_API_KEY=
ZEP_PROJECT_ID=
ZEP_BASE_URL=https://api.getzep.com

# --- Feature Flags (optional) ---
STATSIG_SERVER_KEY=

# --- Sentry Error Tracking (optional) ---
SENTRY_DSN=

# --- RabbitMQ (if using instead of Redis for Celery broker) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=companion
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=companion
